<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Solicitar Vacaciones</title>
<link rel="stylesheet" href="/css/vacations.css" />
</head>
<body>

<div class="page-container">

  <a href="/Dashboard/Index" style="display:inline-flex; align-items:center; gap:6px; color:var(--ink-dim); text-decoration:none; font-size:0.85rem; font-weight:600; margin-bottom:18px;">
    <svg class="ks-icon" viewBox="0 0 24 24" style="width:16px; height:16px;"><path d="M15 18l-6-6 6-6"/></svg>
    Volver al Dashboard
  </a>

  <h1 class="page-title">Solicitar<br>Vacaciones</h1>
  <p class="ks-vac-lead">Selecciona los días que deseas tomar como vacaciones.</p>

  <div class="ks-vac-stats">
    <div class="ks-vac-stat">
      <div class="ks-vac-stat-num">15</div>
      <div class="ks-vac-stat-label">Días disponibles</div>
    </div>
    <div class="ks-vac-stat">
      <div class="ks-vac-stat-num">0</div>
      <div class="ks-vac-stat-label">Días utilizados</div>
    </div>
    <div class="ks-vac-stat">
      <div class="ks-vac-stat-num">15</div>
      <div class="ks-vac-stat-label">Días restantes</div>
    </div>
  </div>

  <div class="ks-vac-grid">

    <!-- Calendario -->
    <div class="card-ks ks-cal-card">
      <div class="ks-cal-head">
        <div class="ks-cal-head-left">
          <div class="ks-cal-icon">
            <svg class="ks-icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
          </div>
          <div>
            <div class="ks-cal-title">Septiembre 2026</div>
            <div class="ks-cal-subtitle">Selecciona tus días de vacaciones</div>
          </div>
        </div>
        <div class="ks-cal-nav">
          <button class="ks-cal-nav-btn" aria-label="Mes anterior">
            <svg class="ks-icon" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="ks-cal-nav-btn" aria-label="Mes siguiente">
            <svg class="ks-icon" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="ks-cal-weekdays">
        <span>DOM</span><span>LUN</span><span>MAR</span><span>MIÉ</span><span>JUE</span><span>VIE</span><span>SÁB</span>
      </div>

      <div class="ks-cal-days">
        <div class="ks-cal-day is-outside">30</div>
        <div class="ks-cal-day is-outside">31</div>
        <div class="ks-cal-day">1</div>
        <div class="ks-cal-day">2</div>
        <div class="ks-cal-day">3</div>
        <div class="ks-cal-day">4</div>
        <div class="ks-cal-day">5</div>

        <div class="ks-cal-day">6</div>
        <div class="ks-cal-day">7</div>
        <div class="ks-cal-day">8</div>
        <div class="ks-cal-day is-today">9</div>
        <div class="ks-cal-day">10</div>
        <div class="ks-cal-day">11</div>
        <div class="ks-cal-day">12</div>

        <div class="ks-cal-day">13</div>
        <div class="ks-cal-day">14</div>
        <div class="ks-cal-day">15</div>
        <div class="ks-cal-day">16</div>
        <div class="ks-cal-day">17</div>
        <div class="ks-cal-day">18</div>
        <div class="ks-cal-day">19</div>

        <div class="ks-cal-day">20</div>
        <div class="ks-cal-day">21</div>
        <div class="ks-cal-day">22</div>
        <div class="ks-cal-day">23</div>
        <div class="ks-cal-day">24</div>
        <div class="ks-cal-day">25</div>
        <div class="ks-cal-day is-outside">26</div>
      </div>
    </div>

    <!-- Columna derecha -->
    <div>
      <div class="card-ks ks-vac-side-card">
        <div class="ks-vac-side-head">
          <div class="ks-vac-side-icon">
            <svg class="ks-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          </div>
          <div>
            <div class="ks-vac-side-title">Mis vacaciones</div>
            <div class="ks-vac-side-subtitle">Año 2026</div>
          </div>
        </div>

        <div class="ks-vac-row">
          <span>Días disponibles</span>
          <span class="ks-vac-row-value">15</span>
        </div>
        <div class="ks-vac-row is-dark">
          <span>Días utilizados</span>
          <span class="ks-vac-row-value">0</span>
        </div>
        <div class="ks-vac-row">
          <span>Días restantes</span>
          <span class="ks-vac-row-value">15</span>
        </div>
      </div>

      <div class="card-ks ks-vac-side-card">
        <div class="ks-vac-side-head">
          <div class="ks-vac-side-icon">
            <svg class="ks-icon" viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.6 1 1.3 1 2.5h6c0-1.2.3-1.9 1-2.5A6 6 0 0 0 12 3z"/></svg>
          </div>
          <div class="ks-vac-side-title">Sugerencias</div>
        </div>
        <p class="ks-vac-tip-text">No hay feriados este mes. Navega a otros meses para ver sugerencias inteligentes.</p>
      </div>

      <div class="card-ks ks-vac-hint-box">
        Haz clic en cualquier día laborable del calendario para marcarlo como vacaciones.
      </div>
    </div>

  </div>

</div>

</body>
</html>
