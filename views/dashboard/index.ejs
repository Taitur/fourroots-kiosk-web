<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<title>Portal Eslabon — Dashboard</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined" />
<link rel="stylesheet" href="/css/styles.css" />
<%- include('../partials/theme-head') %>
</head>
<body>
  <header class="header" data-no-read>
    <div class="header-inner">
      <div class="brand">
        <span class="box"><span class="material-symbols-outlined" style="font-size:17px; color:#fff;">bolt</span></span>
        <span class="name">Eslabon</span>
      </div>
      <div class="header-right">
        <button class="icon-btn" id="narrateBtn" type="button" title="Leer la página en voz alta" aria-label="Leer la página en voz alta" aria-pressed="false"><span class="material-symbols-outlined" id="narrateIcon" style="font-size:18px;">volume_off</span></button>

        <div class="dropdown-wrap">
          <button class="icon-btn" id="themeBtn" type="button" title="Personalizar colores" aria-label="Personalizar colores" aria-haspopup="true" aria-expanded="false" aria-controls="themePanel"><span class="material-symbols-outlined" style="font-size:18px;">palette</span></button>
          <div class="dropdown-panel theme-panel" id="themePanel" role="dialog" aria-label="Personalizar portal">
            <div class="dropdown-head"><p style="font-size:15px;">Personalizar portal</p><span style="font-size:13px;">Selecciona un tema de color</span></div>
            <div class="panel-section">
              <p class="panel-section-title">Temas</p>
              <div class="theme-swatches" id="themeSwatches"></div>
              <p class="panel-section-title">Accesibilidad · Daltonismo</p>
              <div class="theme-cb-list" id="themeCbList"></div>
            </div>
          </div>
        </div>

        <div class="dropdown-wrap">
          <button class="icon-btn" id="appsBtn" type="button" title="Navegar entre aplicaciones" aria-label="Navegar entre aplicaciones" aria-haspopup="true" aria-expanded="false" aria-controls="appsPanel"><span class="material-symbols-outlined" style="font-size:18px;">space_dashboard</span></button>
          <div class="dropdown-panel apps-panel" id="appsPanel" role="dialog" aria-label="Aplicaciones">
            <div class="dropdown-head apps-panel-head">
              <p style="font-size:15px;">Aplicaciones</p>
              <button class="apps-panel-close" id="appsClose" type="button" aria-label="Cerrar"><span class="material-symbols-outlined" style="font-size:20px;">close</span></button>
            </div>
            <div class="apps-panel-body">
              <% modules.forEach((m) => {
                   const firstApp = m.apps.find((a) => a.url); %>
                <div class="apps-group">
                  <div class="apps-group-head">
                    <span class="apps-group-name"><span class="material-symbols-outlined" style="font-size:16px;"><%= m.icon %></span><%= m.title %></span>
                    <% if (firstApp) { %>
                      <a class="apps-group-link" href="<%= firstApp.url %>">Ver módulo</a>
                    <% } %>
                  </div>
                  <% m.apps.forEach((a) => { %>
                    <% if (a.url) { %>
                      <a class="apps-item" href="<%= a.url %>"><span class="apps-item-icon"><span class="material-symbols-outlined" style="font-size:18px;"><%= a.icon %></span></span><span><%= a.name %></span></a>
                    <% } else { %>
                      <div class="apps-item is-disabled" title="Próximamente" data-speak="<%= a.name %>. Próximamente."><span class="apps-item-icon"><span class="material-symbols-outlined" style="font-size:18px;"><%= a.icon %></span></span><span><%= a.name %></span></div>
                    <% } %>
                  <% }) %>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="divider"></div>

        <div class="dropdown-wrap">
          <button class="icon-btn" id="bellBtn" title="Notificaciones">
            <span class="material-symbols-outlined" style="font-size:18px;">notifications</span>
            <span class="badge-dot" id="bellBadge" style="display:none;"></span>
          </button>
          <div class="dropdown-panel" id="bellPanel">
            <div class="dropdown-head" style="display:flex; align-items:center; justify-content:space-between;">
              <div><p>Notificaciones</p><span id="unreadLabel"></span></div>
              <a href="#" id="markAllRead" style="font-size:12px; font-weight:600;">Marcar leídas</a>
            </div>
            <div id="notifList"></div>
          </div>
        </div>

        <div class="dropdown-wrap">
          <button class="user-block" id="avatarBtn">
            <span class="avatar"><%= currentUser.initials %></span>
            <span>
              <p class="name"><%= currentUser.name %></p>
              <p class="role"><%= currentUser.role %></p>
            </span>
            <span class="material-symbols-outlined" style="font-size:16px; color:#6B7280;">expand_more</span>
          </button>
          <div class="dropdown-panel" id="userPanel" style="width:220px;">
            <a class="item" style="text-decoration:none; color:inherit;" href="/Avatar"><span class="material-symbols-outlined" style="font-size:18px;">person</span> Mi perfil</a>
            <div class="item"><span class="material-symbols-outlined" style="font-size:18px;">tune</span> Preferencias</div>
            <div class="item" id="userNotifItem"><span class="material-symbols-outlined" style="font-size:18px;">notifications_active</span> Notificaciones</div>
            <div class="item"><span class="material-symbols-outlined" style="font-size:18px;">help</span> Ayuda y soporte</div>
            <a class="item" style="color:var(--tema-error); text-decoration:none;" href="/Account/Logout"><span class="material-symbols-outlined" style="font-size:18px;">logout</span> Cerrar sesión</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="hero">
    <p class="eyebrow">Sistema Integral · Recursos Humanos</p>
    <h1>Portal<br>Empresarial</h1>
    <p class="sub">Accede a todos los módulos de gestión empresarial desde un punto centralizado.</p>
    <div class="stats">
      <div><p class="num"><%= modules.length %></p><p class="label">Módulos activos</p></div>
      <div><p class="num"><%= modules.reduce((sum, m) => sum + m.apps.length, 0) %></p><p class="label">Aplicaciones</p></div>
      <div><p class="num"><%= employeeCount.toLocaleString("es-MX") %></p><p class="label">Empleados registrados</p></div>
    </div>
  </main>

  <div class="modules-wrap">
    <% modules.forEach((m) => {
         const firstApp = m.apps.find((a) => a.url);
         const primerUrl = firstApp ? firstApp.url : null; %>
      <div class="modulo-block">
        <div class="modulo-head">
          <div class="icon-box"><span class="material-symbols-outlined" style="font-size:21px; color:#fff;"><%= m.icon %></span></div>
          <div class="info"><h2><%= m.title %></h2><p><%= m.description %></p></div>
          <% if (primerUrl) { %>
            <a class="btn-abrir" style="text-decoration:none;" href="<%= primerUrl %>">Abrir módulo <span class="material-symbols-outlined" style="font-size:15px;">arrow_forward</span></a>
          <% } else { %>
            <button class="btn-abrir" disabled style="opacity:.5; cursor:not-allowed;">Abrir módulo <span class="material-symbols-outlined" style="font-size:15px;">arrow_forward</span></button>
          <% } %>
        </div>
        <div class="apps-row">
          <% m.apps.forEach((a) => { %>
            <% if (a.url) { %>
              <a class="app-card" style="text-decoration:none; color:inherit; cursor:pointer;" href="<%= a.url %>">
                <div class="icono">
                  <div class="deco1"></div>
                  <div class="deco2"></div>
                  <span class="material-symbols-outlined ico"><%= a.icon %></span>
                </div>
                <div class="cuerpo"><p><%= a.name %></p><span><%= a.desc %></span></div>
              </a>
            <% } else { %>
              <div class="app-card" style="opacity:.55;" title="Próximamente" data-speak="<%= a.name %>. <%= a.desc %>. Próximamente.">
                <div class="icono">
                  <div class="deco1"></div>
                  <div class="deco2"></div>
                  <span class="material-symbols-outlined ico"><%= a.icon %></span>
                </div>
                <div class="cuerpo"><p><%= a.name %></p><span><%= a.desc %></span></div>
              </div>
            <% } %>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>

  <script src="/js/dashboard.js"></script>
  <script src="/js/portal-tools.js"></script>
</body>
</html>
