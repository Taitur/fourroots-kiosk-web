@{
    ViewData["Title"] = "Style Guide";
}

<div class="page-container">
    <h1 class="page-title">Style Guide</h1>
    <p class="page-subtitle">Components for the Kiosk</p>

    <h2>Colors</h2>
    <p>--navy (#0B0F1F) · --accent (#6C5CE7) · --accent2 (#FF6B6B) · --good (#1FA97A)</p>
    <p>--paper (#F6F7FB) · --card (#FFFFFF) · --ink (#12142B) · --ink-dim (#6B7089) · --ink-faint (#9AA0BD)</p>
    <p>Change the whole palette per client company with <code>data-theme="mint"</code>, <code>"sunset"</code> or <code>"ocean"</code> on any container.</p>

    <h2>Buttons</h2>

    <p>.btn-ks .btn-ks-primary</p>
    <button class="btn-ks btn-ks-primary">Save</button>

    <p>.btn-ks .btn-ks-secondary</p>
    <button class="btn-ks btn-ks-secondary">Answer survey</button>

    <p>.btn-ks .btn-ks-dark</p>
    <button class="btn-ks btn-ks-dark">Log out</button>

    <p>.btn-ks .btn-ks-outline</p>
    <button class="btn-ks btn-ks-outline">View more</button>

    <p>.btn-ks .btn-ks-outline-dark</p>
    <button class="btn-ks btn-ks-outline-dark">Edit</button>

    <p>.btn-ks .btn-ks-ghost</p>
    <button class="btn-ks btn-ks-ghost">Cancel</button>

    <p>.btn-ks .btn-ks-primary .btn-ks-sm</p>
    <button class="btn-ks btn-ks-primary btn-ks-sm">Publish</button>

    <p>.btn-ks .btn-ks-disabled</p>
    <button class="btn-ks btn-ks-disabled" disabled>Already answered</button>

    <p>.btn-ks .btn-ks-primary .btn-ks-lg</p>
    <button class="btn-ks btn-ks-primary btn-ks-lg">Request time off</button>


    <h2>Cards</h2>

    <p>.card-ks</p>
    <div class="card-ks">
        <p>Regular card, used for generic content blocks</p>
    </div>

    <br>

    <p>.card-ks-featured</p>
    <div class="card-ks-featured">
        <p>Featured card, for priority content</p>
    </div>

    <br>

    <p>.card-ks-disabled</p>
    <div class="card-ks-disabled">
        <p>Disabled card, for closed or expired content</p>
    </div>

    <br>

    <p>.ks-module-tile — dark gradient tile used on the company home portal</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(160px,1fr)); gap:12px;">
        <div class="ks-module-tile">
            <div class="ks-module-icon">
                <svg class="ks-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/></svg>
            </div>
            <div>
                <strong>Payroll</strong>
                <p style="font-size:11px; opacity:.7; margin-top:2px;">Pay and compensation</p>
            </div>
        </div>
        <div class="ks-module-tile">
            <div class="ks-module-icon">
                <svg class="ks-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-4 4.5-6 7-6s5.5 2 7 6"/></svg>
            </div>
            <div>
                <strong>Human Capital</strong>
                <p style="font-size:11px; opacity:.7; margin-top:2px;">Talent and development</p>
            </div>
        </div>
    </div>


    <h2>Inputs</h2>

    <p>.label-ks + .input-ks inside .form-group-ks</p>

    <div class="form-group-ks">
        <label class="label-ks">Name</label>
        <input class="input-ks" type="text" placeholder="Jose Torres">
    </div>

    <div class="form-group-ks">
        <label class="label-ks">Email</label>
        <input class="input-ks" type="email" placeholder="email@company.com">
    </div>


    <h2>Top bar</h2>

    <p>.ks-topbar with .ks-brand, .ks-icon-btn, .ks-lang-btn and .ks-user-chip</p>
    <div class="ks-topbar" style="border-radius: 12px;">
        <div class="ks-brand">
            <div class="ks-brand-mark">E</div>
            <span>Eslabon</span>
            <span style="opacity:.5; font-weight:500; font-size:13px; margin-left:4px;">· Community</span>
        </div>
        <div class="ks-top-actions">
            <button class="ks-icon-btn">
                <svg class="ks-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
            </button>
            <button class="ks-lang-btn">EN</button>
            <button class="ks-icon-btn">
                <svg class="ks-icon" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 4 2 5 2 5H4s2-1 2-5Z"/></svg>
                <span class="ks-icon-badge">3</span>
            </button>
            <div class="ks-user-chip">
                <canvas id="topbar-avatar" width="30" height="30" style="border-radius:50%;"></canvas>
                <div>
                    <p class="ks-user-name">Carolina Loera</p>
                    <p class="ks-user-role">Software team</p>
                </div>
            </div>
        </div>
    </div>


    <h2>Navigation item</h2>

    <p>.ks-nav-item (default and .active)</p>
    <div style="max-width:220px; background:var(--navy); padding:10px; border-radius:12px;">
        <button class="ks-nav-item active" style="color:#fff;">
            <svg class="ks-icon" viewBox="0 0 24 24"><path d="M4 12 12 4l8 8"/></svg>
            <span>Home</span>
        </button>
        <button class="ks-nav-item" style="color:#B8BEDB;">
            <svg class="ks-icon" viewBox="0 0 24 24"><path d="M12 8c-1.5 0-1.5-2 0-3"/></svg>
            <span>Birthdays</span>
        </button>
    </div>


    <h2>Composer</h2>

    <p>.ks-composer with .ks-type-chip</p>
    <div class="ks-composer">
        <div class="ks-row">
            <canvas id="composer-avatar" width="36" height="36" style="border-radius:50%;"></canvas>
            <input type="text" placeholder="Write something for your team...">
        </div>
        <div class="ks-composer-types">
            <button class="ks-type-chip">
                <svg class="ks-icon" viewBox="0 0 24 24" style="width:15px;height:15px;"><rect x="3" y="4" width="18" height="16" rx="2"/></svg>
                <span>Image</span>
            </button>
            <button class="ks-type-chip">
                <svg class="ks-icon" viewBox="0 0 24 24" style="width:15px;height:15px;"><path d="M5 20V10"/><path d="M12 20V4"/><path d="M19 20v-7"/></svg>
                <span>Survey</span>
            </button>
            <button class="ks-type-chip">
                <svg class="ks-icon" viewBox="0 0 24 24" style="width:15px;height:15px;"><circle cx="12" cy="8" r="4"/></svg>
                <span>Kudos</span>
            </button>
        </div>
    </div>


    <h2>Tabs</h2>

    <p>.ks-tabs with .ks-tab (.active)</p>
    <div class="ks-tabs">
        <div class="ks-tab active">All</div>
        <div class="ks-tab">Following</div>
        <div class="ks-tab">My company</div>
        <div class="ks-tab">Teams</div>
    </div>


    <h2>Posts</h2>

    <p>.ks-post with .ks-tag variants (.ks-tag-kudos / .ks-tag-wellness / .ks-tag-survey)</p>

    <div class="ks-post">
        <div class="ks-post-head">
            <canvas class="ks-pav" id="post-avatar-1" width="38" height="38" style="border-radius:50%;"></canvas>
            <div class="ks-post-meta">
                <div class="ks-post-name">Ana Garcia <span class="ks-tag ks-tag-kudos">Kudos</span></div>
                <div class="ks-post-sub">HR team · 2 hours ago</div>
            </div>
        </div>
        <div class="ks-post-body">Thanks to everyone for joining the team-building event. It was great to see so much enthusiasm.</div>
        <div class="ks-post-actions">
            <button class="ks-like-btn">
                <svg class="ks-icon" viewBox="0 0 24 24"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.4-9.5 9-9.5 9Z"/></svg>
                <span>52</span>
            </button>
            <button>
                <svg class="ks-icon" viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V6a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/></svg>
                <span>18</span>
            </button>
        </div>
    </div>

    <div class="ks-post">
        <div class="ks-post-head">
            <canvas class="ks-pav" id="post-avatar-2" width="38" height="38" style="border-radius:50%;"></canvas>
            <div class="ks-post-meta">
                <div class="ks-post-name">Luis Herrera <span class="ks-tag ks-tag-wellness">Wellness</span></div>
                <div class="ks-post-sub">Sales · 4 hours ago</div>
            </div>
        </div>
        <div class="ks-post-body">Tip of the day: stretch your neck and shoulders for two minutes every hour.</div>
        <div class="ks-post-actions">
            <button><svg class="ks-icon" viewBox="0 0 24 24"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.4-9.5 9-9.5 9Z"/></svg><span>31</span></button>
        </div>
    </div>


    <h2>Survey</h2>

    <p>.ks-survey-opt with .ks-survey-bar-track / .ks-survey-bar-fill</p>
    <div class="ks-survey-opt">
        <span>Home office</span>
        <span>68%</span>
    </div>
    <div class="ks-survey-bar-track"><div class="ks-survey-bar-fill" style="width:68%;"></div></div>

    <div class="ks-survey-opt" style="margin-top:10px;">
        <span>Flexible hours</span>
        <span>32%</span>
    </div>
    <div class="ks-survey-bar-track"><div class="ks-survey-bar-fill" style="width:32%;"></div></div>


    <h2>Right rail</h2>

    <p>.ks-rail-card / .ks-announce / .ks-bday-mini</p>
    <div style="max-width:280px;">
        <div class="ks-rail-card ks-announce">
            <p class="ks-announce-kicker">Featured notice</p>
            <p class="ks-announce-title">New vacation policy now available</p>
            <button>Read more</button>
        </div>
        <div class="ks-rail-card">
            <h3>Today's birthdays</h3>
            <div class="ks-bday-mini">
                <canvas class="ks-pav" id="rail-avatar" width="30" height="30" style="border-radius:50%;"></canvas>
                <div class="ks-bday-info">
                    <p class="ks-bday-name">Ana Garcia</p>
                    <p class="ks-bday-area">HR team</p>
                </div>
                <button>Greet</button>
            </div>
        </div>
    </div>


    <h2>Birthday card</h2>

    <p>.ks-bday-card with .ks-congrats-box</p>
    <div style="max-width:200px;">
        <div class="ks-bday-card">
            <canvas class="ks-pav" id="bday-avatar" width="52" height="52"></canvas>
            <p class="ks-bday-name">Sofia Torres</p>
            <p class="ks-bday-area">Marketing</p>
            <button class="ks-cta">Greet</button>
        </div>
    </div>


    <h2>Avatar editor</h2>

    <p>.ks-avatar-editor with .ks-swatch and .ks-hat-btn</p>
    <div class="ks-avatar-editor" style="max-width:280px;">
        <canvas id="editor-avatar" width="88" height="88"></canvas>
        <p style="font-size:11px; font-weight:700; color:var(--ink-dim); margin:10px 0 4px;">Skin tone</p>
        <div class="ks-swatch-row" id="editor-colors"></div>
        <p style="font-size:11px; font-weight:700; color:var(--ink-dim); margin:12px 0 4px;">Hair style</p>
        <div class="ks-hat-row" id="editor-hairstyles"></div>
    </div>


    <h2>XP bar</h2>

    <p>.ks-xp-bar with .ks-xp-fill</p>
    <div class="ks-xp-bar" style="max-width:280px;"><div class="ks-xp-fill" style="width:63%;"></div></div>
    <p style="font-size:11px; color:var(--ink-faint); margin-top:5px;">920 / 1,460 XP</p>


    <h2>Badges</h2>

    <p>.ks-badge-grid with .ks-badge-item (.earned)</p>
    <div class="ks-badge-grid" style="max-width:400px;">
        <div class="ks-badge-item earned">
            <svg class="ks-icon" viewBox="0 0 24 24"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.4-9.5 9-9.5 9Z"/></svg>
            <p>Wellness voice</p>
        </div>
        <div class="ks-badge-item">
            <svg class="ks-icon" viewBox="0 0 24 24"><path d="M12 8c-1.5 0-1.5-2 0-3s1.5-2 0-3"/></svg>
            <p>Never forgets</p>
        </div>
    </div>


    <h2>Manager view</h2>

    <p>.ks-manager-banner</p>
    <div class="ks-manager-banner">
        <div>
            <p class="ks-mgr-banner-title">You're viewing the manager panel</p>
            <p class="ks-mgr-banner-sub">Employees never see this comparison between peers</p>
        </div>
        <button>Exit</button>
    </div>

    <p>.ks-mgr-table with .ks-mgr-row (.head)</p>
    <div class="ks-mgr-table" style="max-width:400px;">
        <div class="ks-mgr-row head"><span>Name</span><span style="text-align:right;">Points</span></div>
        <div class="ks-mgr-row"><span class="ks-mgr-name">Carlos Mendoza</span><span class="ks-mgr-points">34</span></div>
        <div class="ks-mgr-row"><span class="ks-mgr-name">Sofia Torres</span><span class="ks-mgr-points">29</span></div>
    </div>


    <h2>Modal</h2>

    <p>.ks-modal with .ks-type-grid / .ks-type-opt and .ks-modal-actions</p>
    <div class="ks-modal" style="max-width:420px; border:1px solid var(--border);">
        <h3>Create a post</h3>
        <div class="ks-type-grid">
            <div class="ks-type-opt selected">
                <svg class="ks-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/></svg>
                <span>Image</span>
            </div>
            <div class="ks-type-opt">
                <svg class="ks-icon" viewBox="0 0 24 24"><path d="M5 20V10M12 20V4M19 20v-7"/></svg>
                <span>Survey</span>
            </div>
            <div class="ks-type-opt">
                <svg class="ks-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/></svg>
                <span>Kudos</span>
            </div>
        </div>
        <textarea placeholder="What do you want to share?"></textarea>
        <div class="ks-modal-actions">
            <button class="btn-ks-ghost">Cancel</button>
            <button class="btn-ks-primary">Publish</button>
        </div>
    </div>


    <h2>Floating action button &amp; toast</h2>

    <p>.ks-fab (bottom-right corner of the viewport) and .ks-toast</p>
    <div style="position:relative; height:70px; background:var(--paper); border:1px dashed var(--border); border-radius:12px;">
        <button class="ks-fab" style="position:absolute; bottom:10px; right:10px;">+</button>
    </div>
    <div class="ks-toast show" style="position:relative; left:0; bottom:0; transform:none; display:inline-block; margin-top:10px;">Post published</div>

</div>

<script>
    /* ---------- lightweight canvas avatar renderer, ported from the
       Eslabon Comunidad prototype, used to preview the avatar system ---------- */
    function drawHair(ctx, r, style, color) {
        if (style === "none") return;
        ctx.fillStyle = color;
        if (style === "short") {
            ctx.beginPath();
            ctx.ellipse(0, -r * 0.55, r * 0.75, r * 0.45, 0, Math.PI, Math.PI * 2);
            ctx.fill();
        } else if (style === "long") {
            ctx.beginPath();
            ctx.ellipse(0, -r * 0.5, r * 0.8, r * 0.5, 0, Math.PI, Math.PI * 2);
            ctx.fill();
            ctx.fillRect(-r * 0.78, -r * 0.2, r * 0.22, r * 1.1);
            ctx.fillRect(r * 0.56, -r * 0.2, r * 0.22, r * 1.1);
        } else if (style === "curly") {
            for (let i = -3; i <= 3; i++) {
                ctx.beginPath();
                ctx.arc(i * r * 0.22, -r * 0.55, r * 0.22, 0, Math.PI * 2);
                ctx.fill();
            }
        }
    }

    function drawAvatar(canvas, skin, hairStyle, hairColor) {
        const c = canvas.getContext("2d");
        const r = canvas.width / 2;
        c.clearRect(0, 0, canvas.width, canvas.height);
        c.save();
        c.translate(r, r);
        c.fillStyle = skin;
        c.beginPath();
        c.ellipse(0, r * 0.06, r * 0.72, r * 0.82, 0, 0, Math.PI * 2);
        c.fill();
        c.fillStyle = "rgba(20,15,10,0.85)";
        c.beginPath(); c.arc(-r * 0.28, -r * 0.02, r * 0.08, 0, Math.PI * 2); c.fill();
        c.beginPath(); c.arc(r * 0.28, -r * 0.02, r * 0.08, 0, Math.PI * 2); c.fill();
        c.strokeStyle = "rgba(20,15,10,0.7)";
        c.lineWidth = Math.max(1.4, r * 0.07);
        c.beginPath();
        c.arc(0, r * 0.22, r * 0.28, 0.15 * Math.PI, 0.85 * Math.PI);
        c.stroke();
        drawHair(c, r, hairStyle || "none", hairColor || "#2C2416");
        c.restore();
    }

    const skinTones = ["#FFDBAC", "#F1C27D", "#E0AC69", "#C68642", "#8D5524", "#5C3A21"];
    let mySkin = skinTones[0], myHairStyle = "short", myHairColor = "#2C2416";

    function refreshMyAvatars() {
        ["topbar-avatar", "composer-avatar", "editor-avatar"].forEach(id => {
            const el = document.getElementById(id);
            if (el) drawAvatar(el, mySkin, myHairStyle, myHairColor);
        });
    }

    document.querySelectorAll(".ks-pav").forEach((cv, i) => {
        drawAvatar(cv, skinTones[i % skinTones.length], ["short", "long", "curly"][i % 3], "#2C2416");
    });

    const colorsWrap = document.getElementById("editor-colors");
    skinTones.forEach((color, i) => {
        const b = document.createElement("div");
        b.className = "ks-swatch" + (i === 0 ? " active" : "");
        b.style.background = color;
        b.addEventListener("click", () => {
            mySkin = color;
            [...colorsWrap.children].forEach(x => x.classList.remove("active"));
            b.classList.add("active");
            refreshMyAvatars();
        });
        colorsWrap.appendChild(b);
    });

    const hairStyles = ["none", "short", "long", "curly"];
    const hairWrap = document.getElementById("editor-hairstyles");
    hairStyles.forEach((style, i) => {
        const b = document.createElement("button");
        b.className = "ks-hat-btn" + (style === myHairStyle ? " active" : "");
        b.textContent = style;
        b.addEventListener("click", () => {
            myHairStyle = style;
            [...hairWrap.children].forEach(x => x.classList.remove("active"));
            b.classList.add("active");
            refreshMyAvatars();
        });
        hairWrap.appendChild(b);
    });

    refreshMyAvatars();
</script>
