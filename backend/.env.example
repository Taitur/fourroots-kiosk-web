# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.

# --- Base de datos (SQL Server) ---
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Servidor ---
PORT=3000
NODE_ENV=production
# Obligatorio en producción: cadena larga y aleatoria (p. ej. `openssl rand -hex 32`).
SESSION_SECRET=
# Detrás de Nginx/balanceador: número de proxies de confianza (necesario para la cookie secure).
TRUST_PROXY=1

# --- Frontend ---
# true (por defecto): el backend también sirve la carpeta ../frontend -> un solo servidor.
# false: solo API; el frontend se aloja aparte.
SERVE_FRONTEND=true
# FRONTEND_DIR=../frontend

# --- Solo si el frontend está en OTRO dominio/origen ---
# Orígenes permitidos (separados por comas), p. ej. https://app.midominio.com
CORS_ORIGIN=
# Con orígenes distintos y HTTPS: none. Mismo sitio: lax (por defecto).
COOKIE_SAMESITE=lax
# Fuerza la cookie secure on/off (por defecto: true en producción). Solo desactívalo si no usas HTTPS.
# COOKIE_SECURE=true
