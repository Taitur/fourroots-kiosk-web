@model AttendanceViewModel
@using System.Globalization
@{
    ViewData["Title"] ??= $"Ficha de Asistencia · {Model.Employee.Name}";
    var inv = CultureInfo.InvariantCulture;
    var firstMetric = Model.Metrics.First();

    // Mapa que consume el selector de la gráfica en el cliente.
    var chartData = Model.Metrics.ToDictionary(
        m => m.Key,
        m => new
        {
            values = m.Values,
            color = m.Color,
            unit = m.Unit,
            name = m.ChartTitle
        });
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/attendance.css" asp-append-version="true" />
}

<div class="dash-page">

    <div class="dash-topbar">
        <a class="dash-brand" style="text-decoration:none;" asp-controller="Dashboard" asp-action="Index">
            <div class="dash-brand-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
            </div>
            <span class="dash-brand-name">Eslabon</span>
        </a>
        <div class="dash-profile">
            <div class="dash-profile-text">
                <div class="dash-profile-name">María Andrade</div>
                <div class="dash-profile-role">Administrador</div>
            </div>
            <div class="dash-profile-avatar">MA</div>
        </div>
    </div>

    <div class="dash-wrap">

        <div class="dash-hero">
            <div class="dash-eyebrow">Ficha de asistencia · Recursos Humanos</div>
            <h1>Historial del<br>Empleado</h1>
            <p class="dash-sub">Consulta faltas, puntualidad, horas extra y ascensos de un colaborador a lo largo del tiempo, en un solo lugar.</p>

            <div class="dash-punchcard">
                <div class="dash-pc-left">
                    <div class="dash-pc-avatar">@Model.Employee.Initials</div>
                    <div>
                        <div class="dash-pc-name">@Model.Employee.Name</div>
                        <div class="dash-pc-role">@Model.Employee.Role</div>
                        <div class="dash-pc-meta">
                            <div>ID<span>@Model.Employee.EmployeeId</span></div>
                            <div>Antigüedad<span>@Model.Employee.Seniority</span></div>
                            <div>Turno<span>@Model.Employee.Shift</span></div>
                        </div>
                    </div>
                </div>
                <div class="dash-pc-right">
                    <div class="dash-pc-status">@Model.PeriodStatus</div>
                    <div class="dash-pc-date">@Model.PeriodRange</div>
                </div>
            </div>
        </div>

        <div class="dash-divider"></div>

        <div class="dash-stats">
            <div>
                <div class="dash-stat-num warn">@Model.TotalFaltas</div>
                <div class="dash-stat-label">Faltas totales</div>
            </div>
            <div>
                <div class="dash-stat-num warn">@Model.TotalTardanzas</div>
                <div class="dash-stat-label">Llegadas tarde</div>
            </div>
            <div>
                <div class="dash-stat-num good">@Model.TotalTempranas</div>
                <div class="dash-stat-label">Llegadas temprano</div>
            </div>
            <div>
                <div class="dash-stat-num brass">@Model.TotalHorasExtra</div>
                <div class="dash-stat-label">Horas extra acumuladas</div>
            </div>
            <div>
                <div class="dash-stat-num">@Model.TotalAscensos</div>
                <div class="dash-stat-label">Ascensos</div>
            </div>
        </div>

        <div class="dash-divider"></div>

        <div class="dash-module-head">
            <div class="dash-module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
            </div>
            <div>
                <div class="dash-module-title">Asistencia</div>
                <div class="dash-module-desc">Historial mensual del colaborador</div>
            </div>
        </div>

        <div class="dash-modules">
            @foreach (var metric in Model.Metrics)
            {
                <button type="button"
                        class="dash-module-card@(metric.Key == firstMetric.Key ? " active" : "")"
                        data-metric="@metric.Key"
                        aria-pressed="@(metric.Key == firstMetric.Key ? "true" : "false")">
                    <svg viewBox="0 0 24 24">@Html.Raw(metric.IconSvg)</svg>
                    <div class="dash-module-card-label">@metric.Label</div>
                </button>
            }
        </div>

        <div class="dash-panel">
            <div class="dash-panel-top">
                <div>
                    <div class="dash-section-title" id="dash-panel-title">@firstMetric.ChartTitle</div>
                    <div class="dash-section-sub" id="dash-panel-sub">@Model.PeriodRangeLong</div>
                </div>
                <div class="dash-panel-figures">
                    <div>
                        <div class="dash-pf-num" id="dash-pf-total">@(firstMetric.Total)@firstMetric.Unit</div>
                        <div class="dash-pf-label">Total del periodo</div>
                    </div>
                    <div>
                        <div class="dash-pf-num" id="dash-pf-avg">@firstMetric.Average.ToString("0.0", inv)@firstMetric.Unit</div>
                        <div class="dash-pf-label">Promedio mensual</div>
                    </div>
                </div>
            </div>
            <div class="dash-chart-wrap">
                <canvas id="dash-metric-chart" role="img" aria-label="Gráfica mensual de la métrica de asistencia seleccionada"></canvas>
            </div>
        </div>

        <div class="dash-module-head">
            <div class="dash-module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V10l8-6 8 6v11M9 21v-6h6v6" /></svg>
            </div>
            <div>
                <div class="dash-module-title">Ascensos</div>
                <div class="dash-module-desc">Trayectoria del colaborador dentro de la empresa</div>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-timeline">
                @foreach (var item in Model.Promotions)
                {
                    <div class="dash-tl-item@(item.Upcoming ? " upcoming" : "")">
                        <div class="dash-tl-date">@item.Date</div>
                        <div class="dash-tl-title">@item.Title</div>
                        <div class="dash-tl-desc">@item.Description</div>
                    </div>
                }
            </div>
        </div>

        <footer class="dash-footer">
            <p>Portal empresarial · Módulo de Nómina · Datos de ejemplo</p>
        </footer>

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script>
        (function () {
            const months = @Html.Raw(Json.Serialize(Model.Months));
            const metricData = @Html.Raw(Json.Serialize(chartData));
            const firstMetric = @Html.Raw(Json.Serialize(firstMetric.Key));

            const titleEl = document.getElementById('dash-panel-title');
            const subEl = document.getElementById('dash-panel-sub');
            const totalEl = document.getElementById('dash-pf-total');
            const avgEl = document.getElementById('dash-pf-avg');
            const subText = subEl.textContent;

            let chart;

            function renderChart(metric) {
                const d = metricData[metric];
                if (!d) return;

                titleEl.textContent = d.name;
                subEl.textContent = subText;

                const total = d.values.reduce((a, b) => a + b, 0);
                const unit = d.unit || '';
                totalEl.textContent = total + unit;
                avgEl.textContent = (total / d.values.length).toFixed(1) + unit;

                const ctx = document.getElementById('dash-metric-chart');
                if (chart) chart.destroy();
                chart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: months,
                        datasets: [{
                            label: d.name,
                            data: d.values,
                            backgroundColor: d.color,
                            borderRadius: 4,
                            maxBarThickness: 34
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false }, ticks: { font: { family: 'IBM Plex Mono', size: 12 }, color: '#5B6472' } },
                            y: { beginAtZero: true, grid: { color: '#EAEBE7' }, ticks: { font: { family: 'IBM Plex Mono', size: 12 }, color: '#5B6472' } }
                        }
                    }
                });
            }

            document.querySelectorAll('.dash-module-card').forEach(card => {
                card.addEventListener('click', () => {
                    document.querySelectorAll('.dash-module-card').forEach(c => {
                        c.classList.remove('active');
                        c.setAttribute('aria-pressed', 'false');
                    });
                    card.classList.add('active');
                    card.setAttribute('aria-pressed', 'true');
                    renderChart(card.dataset.metric);
                });
            });

            renderChart(firstMetric);
        })();
    </script>
}
